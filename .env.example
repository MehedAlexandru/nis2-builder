# =============================================================================
# NIS2 Compass — environment template
# Copy to .env for local development:  cp .env.example .env
# NEVER commit real secrets. Production values come from Kubernetes Secrets /
# External Secrets / Vault. Generate secrets with: openssl rand -base64 48
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# API listens here (container-internal port is always 3000)
API_PORT=3000
# Public URL of the SPA (used in emails and CORS)
PUBLIC_APP_URL=http://localhost:5173
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Set to "false" to boot the API without Redis/BullMQ (used for OpenAPI generation)
ENABLE_QUEUES=true

# ── PostgreSQL 16 ───────────────────────────────────────────────────────────
POSTGRES_USER=nis2
POSTGRES_PASSWORD=nis2_dev_password
POSTGRES_DB=nis2_compass
# Migrations and seeding use this owner/superuser connection.
DATABASE_URL=postgresql://nis2:nis2_dev_password@localhost:5432/nis2_compass?schema=public
# Runtime connection (Phase 1: least-privilege role subject to RLS).
# Leave empty in Phase 0 to reuse DATABASE_URL.
APP_DATABASE_URL=

# ── Redis 7 (cache, rate limiting, BullMQ) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication (Phase 1) ────────────────────────────────────────────────
JWT_ACCESS_SECRET=local-dev-only-change-me-access-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=local-dev-only-change-me-refresh-secret
JWT_REFRESH_TTL_SECONDS=2592000
# Used to sign the CSRF cookie (Phase 1)
COOKIE_SECRET=local-dev-only-change-me-cookie-secret
# One-time bootstrap token for the first ADMIN seed CLI (Phase 1)
ADMIN_BOOTSTRAP_TOKEN=local-dev-only-change-me-bootstrap-token
# Base64-encoded 32-byte key for envelope encryption (dev only)
ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── S3 / MinIO (exports, attachments) ───────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=nis2-compass
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Email (Mailpit locally) ─────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NIS2 Compass <no-reply@nis2-compass.local>"

# ── PDF generation worker (Phase 4) ─────────────────────────────────────────
PDF_WORKER_URL=http://localhost:3100

# ── Feature flags ───────────────────────────────────────────────────────────
# AI drafting sends data to a third party only when explicitly enabled AND the
# organization opts in. Disabled by default.
FEATURE_AI_ASSIST=false
# Passkeys / WebAuthn (stretch)
FEATURE_WEBAUTHN=false

# ── Observability ───────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
